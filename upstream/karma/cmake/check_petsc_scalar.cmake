include("${CMAKE_CURRENT_LIST_DIR}/PetscScalarProbe.cmake")
if(NOT DEFINED PETSC_CONFIG_HEADER OR NOT DEFINED EXPECTED_MODE)
    message(FATAL_ERROR "PETSC_CONFIG_HEADER and EXPECTED_MODE are required")
endif()
karma_parse_petsc_scalar_config("${PETSC_CONFIG_HEADER}" actual)
karma_validate_petsc_scalar_mode("${actual}" error)
if(error)
    message(FATAL_ERROR "configured PETSc is unsupported: ${error}")
endif()
if(NOT actual STREQUAL EXPECTED_MODE)
    message(FATAL_ERROR "configured PETSc scalar mode changed: expected '${EXPECTED_MODE}', got '${actual}'")
endif()
message(STATUS "PETSc ${actual}: configured header tested")
