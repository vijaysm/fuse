include_guard(GLOBAL)

function(karma_parse_petsc_scalar_config header output)
    set(parse_error "")
    cmake_parse_arguments(PARSE "" "ERROR_VARIABLE" "" ${ARGN})
    string(LENGTH "${PARSE_ERROR_VARIABLE}" error_variable_length)
    if(NOT EXISTS "${header}")
        set(parse_error "PETSc configuration header not found: ${header}")
    else()
        file(READ "${header}" config)
        if(config MATCHES "#[ \t]*define[ \t]+PETSC_USE_REAL_SINGLE[ \t]+1")
            set(precision single)
        elseif(config MATCHES "#[ \t]*define[ \t]+PETSC_USE_REAL_DOUBLE[ \t]+1")
            set(precision double)
        else()
            set(parse_error "PETSc precision is neither supported single nor double")
        endif()
        string(LENGTH "${parse_error}" parse_error_length)
        if(parse_error_length EQUAL 0)
            if(config MATCHES "#[ \t]*define[ \t]+PETSC_USE_COMPLEX[ \t]+1")
                set(scalar complex)
            else()
                set(scalar real)
            endif()
            set(${output} "${precision} ${scalar}" PARENT_SCOPE)
        endif()
    endif()

    string(LENGTH "${parse_error}" parse_error_length)
    if(parse_error_length GREATER 0)
        set(${output} "" PARENT_SCOPE)
        if(error_variable_length GREATER 0)
            set(${PARSE_ERROR_VARIABLE} "${parse_error}" PARENT_SCOPE)
        else()
            message(FATAL_ERROR "${parse_error}")
        endif()
    elseif(error_variable_length GREATER 0)
        set(${PARSE_ERROR_VARIABLE} "" PARENT_SCOPE)
    endif()
endfunction()

function(karma_validate_petsc_scalar_mode mode error_output)
    if(mode STREQUAL "double real")
        set(error "")
    else()
        set(error "KARMA requires PETSc double real; found '${mode}'")
    endif()
    set(${error_output} "${error}" PARENT_SCOPE)
endfunction()

function(karma_validate_petsc_candidate_report report error_output)
    if(report MATCHES "PETSc candidate ([a-z]+ [a-z]+), scalar ABI: supported, MOAB metadata: compatible")
        set(error "")
    elseif(report MATCHES "PETSc candidate ([a-z]+ [a-z]+), scalar ABI: unsupported")
        set(error "KARMA requires PETSc double real; found '${CMAKE_MATCH_1}'")
    elseif(report MATCHES "PETSc candidate [a-z]+ [a-z]+")
        set(error "candidate does not provide compatible MOAB metadata")
    else()
        set(error "${report}")
    endif()
    set(${error_output} "${error}" PARENT_SCOPE)
endfunction()

function(_karma_read_pc_variable pc_file name output)
    file(STRINGS "${pc_file}" assignments REGEX "^[A-Za-z_][A-Za-z0-9_]*=")
    set(value)
    foreach(assignment IN LISTS assignments)
        if(assignment MATCHES "^${name}=(.*)$")
            set(value "${CMAKE_MATCH_1}")
            break()
        endif()
    endforeach()
    foreach(unused RANGE 8)
        if(NOT value MATCHES "\\$\\{([A-Za-z_][A-Za-z0-9_]*)\\}")
            break()
        endif()
        set(reference "${CMAKE_MATCH_1}")
        set(token "\${${reference}}")
        set(replacement)
        foreach(assignment IN LISTS assignments)
            if(assignment MATCHES "^${reference}=(.*)$")
                set(replacement "${CMAKE_MATCH_1}")
                break()
            endif()
        endforeach()
        if(replacement STREQUAL "")
            break()
        endif()
        string(REPLACE "${token}" "${replacement}" value "${value}")
    endforeach()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(karma_collect_petsc_candidate_dirs output)
    cmake_parse_arguments(COLLECT "" "" "EXPLICIT_DIRS" ${ARGN})
    set(search_dirs ${COLLECT_EXPLICIT_DIRS})
    if(DEFINED ENV{PKG_CONFIG_PATH} AND NOT "$ENV{PKG_CONFIG_PATH}" STREQUAL "")
        cmake_path(CONVERT "$ENV{PKG_CONFIG_PATH}" TO_CMAKE_PATH_LIST pkg_config_dirs NORMALIZE)
        list(APPEND search_dirs ${pkg_config_dirs})
    endif()
    set(prefixes ${CMAKE_PREFIX_PATH})
    if(DEFINED ENV{CMAKE_PREFIX_PATH} AND NOT "$ENV{CMAKE_PREFIX_PATH}" STREQUAL "")
        cmake_path(CONVERT "$ENV{CMAKE_PREFIX_PATH}" TO_CMAKE_PATH_LIST environment_prefixes NORMALIZE)
        list(APPEND prefixes ${environment_prefixes})
    endif()
    foreach(prefix IN LISTS prefixes)
        foreach(suffix IN ITEMS lib/pkgconfig lib64/pkgconfig share/pkgconfig)
            list(APPEND search_dirs "${prefix}/${suffix}")
        endforeach()
    endforeach()

    set(candidate_dirs)
    foreach(search_dir IN LISTS search_dirs)
        cmake_path(ABSOLUTE_PATH search_dir NORMALIZE OUTPUT_VARIABLE candidate_dir)
        if(EXISTS "${candidate_dir}/PETSc.pc")
            list(APPEND candidate_dirs "${candidate_dir}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES candidate_dirs)
    set(${output} "${candidate_dirs}" PARENT_SCOPE)
endfunction()

function(karma_summarize_petsc_variants output configured_mode)
    set(summaries)
    foreach(mode IN ITEMS "single real" "double real" "single complex" "double complex")
        if(mode STREQUAL configured_mode)
            set(status "configured, test status reported by CTest")
        else()
            set(status unavailable)
            foreach(report IN LISTS ARGN)
                if(report MATCHES "PETSc candidate ${mode}, scalar ABI: unsupported")
                    set(status "discovered but unsupported by KARMA's double-real scalar ABI")
                    break()
                elseif(report MATCHES "PETSc candidate ${mode}, scalar ABI: supported, MOAB metadata: compatible")
                    set(status "compatible candidate available, untested (use KARMA_PETSC_VARIANT_PKGCONFIG_DIR)")
                    break()
                elseif(report MATCHES "PETSc candidate ${mode}, scalar ABI: supported, MOAB metadata: incompatible" AND
                       status STREQUAL unavailable)
                    set(status "candidate has incompatible MOAB metadata, untested")
                elseif(report MATCHES "PETSc candidate ${mode}, scalar ABI: supported, MOAB metadata: missing" AND
                       status STREQUAL unavailable)
                    set(status "candidate missing MOAB metadata, untested")
                endif()
            endforeach()
        endif()
        list(APPEND summaries "${mode}: ${status}")
    endforeach()
    set(${output} "${summaries}" PARENT_SCOPE)
endfunction()

function(karma_probe_petsc_candidates output)
    set(reports)
    foreach(pc_dir IN LISTS ARGN)
        cmake_path(ABSOLUTE_PATH pc_dir NORMALIZE OUTPUT_VARIABLE absolute_pc_dir)
        if(NOT EXISTS "${absolute_pc_dir}/PETSc.pc")
            list(APPEND reports "${absolute_pc_dir}: PETSc metadata unavailable")
            continue()
        endif()
        _karma_read_pc_variable("${absolute_pc_dir}/PETSc.pc" prefix prefix)
        if(prefix STREQUAL "")
            list(APPEND reports "${absolute_pc_dir}: PETSc metadata has no prefix")
            continue()
        endif()
        _karma_read_pc_variable("${absolute_pc_dir}/PETSc.pc" includedir includedir)
        if(includedir STREQUAL "")
            set(includedir "${prefix}/include")
        endif()
        unset(header CACHE)
        set(header header-NOTFOUND)
        find_file(header petscconf.h PATHS "${includedir}" "${includedir}/petsc"
                  NO_DEFAULT_PATH)
        karma_parse_petsc_scalar_config("${header}" mode ERROR_VARIABLE probe_error)
        string(LENGTH "${probe_error}" probe_error_length)
        if(probe_error_length GREATER 0)
            list(APPEND reports "${absolute_pc_dir}: ${probe_error}")
            continue()
        endif()
        karma_validate_petsc_scalar_mode("${mode}" scalar_error)
        if(scalar_error)
            set(scalar_abi unsupported)
        else()
            set(scalar_abi supported)
        endif()
        if(EXISTS "${absolute_pc_dir}/MOAB.pc")
            _karma_read_pc_variable("${absolute_pc_dir}/MOAB.pc" prefix moab_prefix)
            cmake_path(NORMAL_PATH prefix OUTPUT_VARIABLE normalized_prefix)
            cmake_path(NORMAL_PATH moab_prefix OUTPUT_VARIABLE normalized_moab_prefix)
            file(GLOB installed_moab_libraries
                 "${normalized_prefix}/lib/libMOAB.*"
                 "${normalized_prefix}/lib64/libMOAB.*")
            if(normalized_moab_prefix STREQUAL normalized_prefix OR installed_moab_libraries)
                set(moab compatible)
            else()
                set(moab incompatible)
            endif()
        else()
            set(moab missing)
        endif()
        list(APPEND reports "${absolute_pc_dir}: PETSc candidate ${mode}, scalar ABI: ${scalar_abi}, MOAB metadata: ${moab}")
    endforeach()
    set(${output} "${reports}" PARENT_SCOPE)
endfunction()
