#pragma once
// Generated by CMake from include/fuse/base/config.hpp.in. Do not edit the
// generated copy; every value here is a build decision and lives in CMake.
#cmakedefine01 FUSE_HAVE_MPI
// Whether the MPI library this was configured against reports CUDA- or
// HIP-aware buffers (cmake/FuseMpiGpuAware.cmake's compile-time probe for
// MPIX_CUDA_AWARE_SUPPORT / MPIX_ROCM_AWARE_SUPPORT). Read by
// fuse::native::mpi_is_gpu_aware() -- informational only; the migration
// exchange stages through host memory regardless (docs/dev/native-mesh.md).
#cmakedefine01 FUSE_MPI_GPU_AWARE
#cmakedefine01 FUSE_HAVE_KOKKOS
#cmakedefine01 FUSE_HAVE_MOAB
// Whether the MOAB we resolved was built WITH TempestRemap. Separate from
// FUSE_HAVE_MOAB because a MOAB without it gives the spherical high-order
// tier no implementation, and the difference must reach the code: the
// ported tempest_weights.cpp read this macro while nothing defined it, so
// the preprocessor read 0 and the high-order path compiled as permanently
// unavailable even where MOAB does provide it.
#cmakedefine01 FUSE_HAVE_TEMPEST
#cmakedefine01 FUSE_HAVE_PETSC
#cmakedefine01 FUSE_HAVE_LOWFIVE
// Whether the examples' SparseLuBackend (examples/common/
// sparse_solve_backend.hpp) is cusolverRf on the device (1) or a passthrough
// to Eigen::SparseLU (0). Library code never reads this; it exists so the
// examples and their verification tests can name which backend produced a
// number.
#cmakedefine01 FUSE_HAVE_CUSPARSE
#cmakedefine01 FUSE_LINALG_EIGEN
#cmakedefine01 FUSE_ENABLE_EXCEPTIONS
// Floating-point contraction policy (KNOWN_ISSUES.md D30; cmake/FuseFpPolicy.cmake).
// 1: -ffp-contract=off was added for this build, in every build type --
// a*b+c is rounded twice (multiply, then add) rather than fused, which
// is the compiler's DEFAULT at every optimization level including -O0
// (docs/dev/testing.md's "Floating-point contraction policy" has the
// measured instruction counts; an earlier comment here wrongly claimed
// -O0 never contracts). 0: the compiler's default contraction policy is
// in effect (fused, single rounding, faster); test/linalg/
// dist_vector_test.cpp and test/num/space_kernels_test.cpp read this
// macro to choose between an exact comparison and a derived
// forward-error bound.
#cmakedefine01 FUSE_FP_REPRODUCIBLE
#define FUSE_LINALG_BACKEND "@FUSE_LINALG_BACKEND@"
#define FUSE_VERSION_STRING "@PROJECT_VERSION@"
// The Kokkos version CMake resolved. A test compares this with the KOKKOS_VERSION
// macro the headers actually define: with several Kokkos installs on one machine
// the include path can pick one and the linker another.
#define FUSE_KOKKOS_VERSION_EXPECTED "@Kokkos_VERSION@"
// Compiler id/version, whether this configure routed every translation unit
// through nvcc_wrapper (because Kokkos::CUDA exists, or because the configured
// compiler was probed to define __NVCC__ -- nvcc's host pass is not a
// transparent passthrough, see below, so the id follows the compiler that
// ran, not the presence of a device backend), and the target architecture. Host-only floating-point code can measure different
// results under nvcc's host pass than under the host compiler directly, even
// with no device code anywhere in the translation unit; this id is how a
// per-toolchain pinned-value baseline (e.g. test/golden/accelerator.golden)
// picks the row that applies to THIS build.
#define FUSE_TOOLCHAIN_ID "@FUSE_TOOLCHAIN_ID@"
