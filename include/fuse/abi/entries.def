/* FUSE participant AND provider ABIs, version 1: the single source of truth
 * for both directions (docs/dev/abi-design.md, "Provider direction").
 *
 * Everything the C ABI exposes is listed here once, as X-macros, and three
 * things are generated or checked from this file:
 *   - the function-pointer table initialisers and their struct_size
 *     assertions (src/abi/participant.cpp, src/abi/provider_adapter.cpp);
 *   - the Fortran module ffuse, for both directions (tools/gen-abi.py);
 *   - the golden test that include/fuse/abi/types.h, participant.h and
 *     provider.h -- the plain C a user reads -- agree with this list member
 *     for member (test/abi/entries_golden_test.cpp).
 * The public headers contain no macros (docs/dev/abi-design.md, point 5).
 *
 * ONE STRUCT CATALOGUE, TWO TABLES. FUSE_ABI_ENTRY lists the participant
 * table (a foreign code drives the coupler, fuse_coupler_abi());
 * FUSE_ABI_PROVIDER_ENTRY lists the provider table (the coupler drives a
 * plugin, fuse_provider_abi()). Both read from the SAME FUSE_ABI_STRUCT
 * catalogue above them -- fuse_field_view and the window carried by
 * fuse_step_request/fuse_step_report are the identical bytes on either
 * side -- so the two directions cannot drift apart on what a field or a
 * time bound looks like.
 *
 * THE ONE RULE. Every entry point has the same shape,
 *     fuse_status name(fuse_ctx* ctx, const IN* in, OUT* out);
 * where IN and OUT are argument structs whose FIRST member is
 * `uint32_t struct_size`, set by the caller to sizeof(its own struct). New
 * arguments are new members APPENDED to a struct; a signature never changes,
 * and a callee reads only the members that `struct_size` says are present
 * (and treats the rest as their documented defaults). A caller built against
 * an older header therefore keeps working against a newer library, and a
 * caller built against a newer header gets FUSE_ERR_VERSION from an older
 * library rather than a misread. Value types (fuse_exact_time,
 * fuse_semantic_version) carry no struct_size and NEVER grow: they are closed.
 *
 * Two parents contributed, and nothing either exposed is lost:
 *   SOMA soma_c.h ........ create/destroy/last_error, load/save graph (bytes
 *                          and YAML), field_handle/register_field with
 *                          strides and memory space, set_communicator,
 *                          set_end_time, begin/end_step, requires_checkpoint
 *                          /restore, is_coupling_ongoing, run_period, run.
 *   KARMA component ABI .. struct_size convention, exact rational time,
 *                          element type / ownership enumerators, capability
 *                          flags, the diagnostic with truncation flag.
 *
 * Usage: define the macros you need, include this file, undefine them.
 *   FUSE_ABI_STRUCT(name, doc)            a struct begins
 *   FUSE_ABI_FIELD(ctype, ftype, name, doc) one member; ftype is the Fortran
 *                                         kind the generator emits
 *   FUSE_ABI_STRUCT_END(name)
 *   FUSE_ABI_ENTRY(name, in, out, doc)    one participant-table member, in order
 *   FUSE_ABI_PROVIDER_ENTRY(name, in, out, doc) one provider-table member, in order
 *   FUSE_ABI_ENUM(name, value, doc)       one enumerator
 * Order is the ABI: a new struct member or table entry is appended at the end
 * of its block, never inserted. ABI v1 is frozen when the first consumer
 * outside this repository links against it; until then this list may change.
 */

#ifndef FUSE_ABI_STRUCT
#define FUSE_ABI_STRUCT(name, doc)
#define FUSE_ABI_STRUCT_DEFINED_HERE
#endif
#ifndef FUSE_ABI_FIELD
#define FUSE_ABI_FIELD(ctype, ftype, name, doc)
#define FUSE_ABI_FIELD_DEFINED_HERE
#endif
#ifndef FUSE_ABI_STRUCT_END
#define FUSE_ABI_STRUCT_END(name)
#define FUSE_ABI_STRUCT_END_DEFINED_HERE
#endif
#ifndef FUSE_ABI_ENTRY
#define FUSE_ABI_ENTRY(name, in, out, doc)
#define FUSE_ABI_ENTRY_DEFINED_HERE
#endif
#ifndef FUSE_ABI_PROVIDER_ENTRY
#define FUSE_ABI_PROVIDER_ENTRY(name, in, out, doc)
#define FUSE_ABI_PROVIDER_ENTRY_DEFINED_HERE
#endif
#ifndef FUSE_ABI_ENUM
#define FUSE_ABI_ENUM(name, value, doc)
#define FUSE_ABI_ENUM_DEFINED_HERE
#endif

/* ---- status codes (values are the ABI and never change) ---------------- */
FUSE_ABI_ENUM(FUSE_OK,              0,  "success")
FUSE_ABI_ENUM(FUSE_ERR_INVALID,    -1,  "malformed argument: null pointer, out-of-range value, bad handle, unparseable input")
FUSE_ABI_ENUM(FUSE_ERR_NOTFOUND,   -2,  "well-formed lookup that found nothing: no such component or field")
FUSE_ABI_ENUM(FUSE_ERR_STATE,      -3,  "valid call in the wrong state: no graph, already initialised, step already open")
FUSE_ABI_ENUM(FUSE_ERR_RUNTIME,    -4,  "an exception was contained at the boundary or an operation failed; last_error has the reason")
FUSE_ABI_ENUM(FUSE_ERR_UNSUPPORTED,-5,  "the entry exists in this ABI but this build cannot perform it")
FUSE_ABI_ENUM(FUSE_ERR_VERSION,    -6,  "struct_size smaller than the oldest layout this library knows, or larger than FUSE_ABI_MAX_STRUCT_SIZE")

/* ---- element types, memory spaces, ownership (fuse_field_view) ---------- */
FUSE_ABI_ENUM(FUSE_ELEMENT_F64,     0,  "IEEE double")
FUSE_ABI_ENUM(FUSE_ELEMENT_I64,     1,  "64-bit signed integer (identifiers, not coupled values)")
FUSE_ABI_ENUM(FUSE_MEMSPACE_HOST,   0,  "pointer addressable by the host CPU")
FUSE_ABI_ENUM(FUSE_MEMSPACE_DEVICE, 1,  "pointer in the default device memory space of this build's Kokkos")
FUSE_ABI_ENUM(FUSE_OWNERSHIP_OWNED, 0,  "every entry owned by this process; the default")
FUSE_ABI_ENUM(FUSE_OWNERSHIP_GHOSTED, 1, "owned entries first, then ghosts; the graph's ownership rule applies")
FUSE_ABI_ENUM(FUSE_OWNERSHIP_REPLICATED, 2, "the whole field on every process")

/* ---- capability flags (fuse_capability_set.flags) -------------------------- */
FUSE_ABI_ENUM(FUSE_CAP_DEVICE_FIELDS,  1,  "FUSE_MEMSPACE_DEVICE accepted")
FUSE_ABI_ENUM(FUSE_CAP_CHECKPOINT,     2,  "requires_checkpoint/requires_restore are meaningful (implicit coupling groups)")
FUSE_ABI_ENUM(FUSE_CAP_MPI,            4,  "a communicator may be set; without it everything runs on one process")
FUSE_ABI_ENUM(FUSE_CAP_MPI_CONNECT,    8,  "coupling between separately launched executables over MPI connect/accept or MPMD")
FUSE_ABI_ENUM(FUSE_CAP_LOWFIVE,       16,  "coupling between executables through LowFive's in-memory HDF5 path")
FUSE_ABI_ENUM(FUSE_CAP_YAML,          32,  "load_graph accepts a YAML path")
FUSE_ABI_ENUM(FUSE_CAP_RESTART_FORM_B, 64,  "save_restart_blob/load_restart_blob are real, not the default no-op")

/* ---- limits ------------------------------------------------------------- */
FUSE_ABI_ENUM(FUSE_ABI_VERSION,        1,  "the table version this header describes")
FUSE_ABI_ENUM(FUSE_ABI_MAX_STRUCT_SIZE, 65536, "a struct_size above this is a corrupt header, not a future one")

/* ---- argument structs --------------------------------------------------- */

FUSE_ABI_STRUCT(fuse_null, "placeholder for an entry with no input or no output; callers pass NULL")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size, "sizeof(fuse_null)")
FUSE_ABI_STRUCT_END(fuse_null)

FUSE_ABI_STRUCT(fuse_version_info, "what this library is")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(fuse_semantic_version,   fuse_semantic_version, library,    "semantic version of the library")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  abi_version,  "highest table version fuse_coupler_abi() answers")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  reserved,     "0; fills the padding so that an appended member changes sizeof (abi-design.md rule 3)")
FUSE_ABI_FIELD(const char*,    c_ptr,      string,       "NUL-terminated, static storage, valid for the library's lifetime")
FUSE_ABI_STRUCT_END(fuse_version_info)

FUSE_ABI_STRUCT(fuse_capability_set, "what this build can do; FUSE_CAP_* bits")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  flags,        "OR of FUSE_CAP_*")
FUSE_ABI_STRUCT_END(fuse_capability_set)

FUSE_ABI_STRUCT(fuse_context_out, "a new context")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(fuse_ctx*,      c_ptr,      ctx,          "owned by the caller until destroy")
FUSE_ABI_STRUCT_END(fuse_context_out)

FUSE_ABI_STRUCT(fuse_error, "the last error on a context (or thread-local when ctx is NULL); the caller owns the buffer")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  status,       "out: the fuse_status of the failed call")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  truncated,    "out: 1 if the message did not fit")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  length,       "out: full message length in bytes, excluding the NUL")
FUSE_ABI_FIELD(char*,          c_ptr,      buffer,       "in: caller's buffer, or NULL to query length only")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  capacity,     "in: bytes available in buffer")
FUSE_ABI_FIELD(const char*,    c_ptr,      code,         "out: the E-... code; valid until the next failing call on this context (or thread, when ctx is NULL). Not static storage: it points into the context's own last_error_code (the thread-local twin when ctx is NULL), and is invalid after fuse_destroy() on this context")
FUSE_ABI_STRUCT_END(fuse_error)

FUSE_ABI_STRUCT(fuse_graph_source, "where a coupling graph comes from; exactly one of yaml_path and bytes is set")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(const char*,    c_ptr,      yaml_path,    "NUL-terminated path, or NULL")
FUSE_ABI_FIELD(const void*,    c_ptr,      bytes,        "canonical descriptor bytes (the frozen model), or NULL")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  byte_count,   "length of bytes")
FUSE_ABI_STRUCT_END(fuse_graph_source)

FUSE_ABI_STRUCT(fuse_graph_sink, "where the loaded graph's canonical bytes are written")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(void*,          c_ptr,      buffer,       "in: caller's buffer, or NULL to query the size")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  capacity,     "in: bytes available")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  written,      "out: bytes the graph needs; nothing is written when it exceeds capacity")
FUSE_ABI_STRUCT_END(fuse_graph_sink)

FUSE_ABI_STRUCT(fuse_restart_blob_sink, "where a provider's own restart-to-disk blob is written (docs/dev/restart.md; opaque, versioned bytes, same-decomposition restore only; the same query-then-fill shape as fuse_graph_sink)")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(void*,          c_ptr,      buffer,       "in: caller's buffer, or NULL to query the size")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  capacity,     "in: bytes available")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  written,      "out: bytes the blob needs; nothing is written when it exceeds capacity")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  blob_version, "out: this provider's own restart_blob_version(), recorded so a reader can refuse an incompatible blob by name rather than by a corrupted read (the same posture kGraphVersion takes for the coupling graph)")
FUSE_ABI_STRUCT_END(fuse_restart_blob_sink)

FUSE_ABI_STRUCT(fuse_restart_blob_source, "a provider's own restart-to-disk blob, read back (docs/dev/restart.md)")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(const void*,    c_ptr,      bytes,        "the blob this SAME provider wrote at an earlier save_restart_blob() call")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  byte_count,   "length of bytes")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  blob_version, "the version recorded when this blob was written")
FUSE_ABI_STRUCT_END(fuse_restart_blob_source)

FUSE_ABI_STRUCT(fuse_setup_options, "process-level settings, before initialize")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(int64_t,        c_int64_t,  communicator, "Fortran handle of the communicator this process couples on (MPI_Comm_c2f), or 0 for none -- unless my_component names a component whose LaunchSpec is Mpmd or Connect, in which case this is the world communicator this process starts in (its own MPI_COMM_WORLD, already MPI_Init'd) and fuse_setup() forms the real base communicator from it via fuse::transport::connect() before storing it; see my_component")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  has_end_time, "1 if end_time is set")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  reserved,     "must be 0; not validated by this host")
FUSE_ABI_FIELD(fuse_exact_time, fuse_exact_time, end_time, "when is_coupling_ongoing turns false, when has_end_time is set; the graph carries no end time of its own to fall back on. A run with no end_time is unbounded until the caller's own loop, or fuse_run()'s periods count, stops it")
FUSE_ABI_FIELD(const char*,    c_ptr,      my_component, "NUL-terminated name of the graph component this process plays, or NULL (the default) to use `communicator` exactly as given, with no connect() call. Required to form a real base communicator when the loaded graph declares this component's LaunchSpec as Mpmd (MPI_COMM_WORLD already shared; the call reads MPI_APPNUM and checks it) or Connect (separately launched executables; the call does the MPI_Open_port/MPI_Comm_accept or MPI_Comm_connect handshake named by LaunchSpec::port_file/service_name/is_acceptor, then MPI_Intercomm_merge). For InProcess or Plugin it behaves as when NULL, since fuse::transport::connect() refuses both. A C or Fortran caller therefore never calls C++ directly: setting this one field is the whole difference between an in-process run and a multi-executable one. Ignored (NULL-equivalent) by a caller whose struct_size predates this field, per abi-design.md rule 2")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  has_communicator, "1 if `communicator` is a deliberately supplied handle, including the valid handle 0: Open MPI's Fortran handle for MPI_COMM_WORLD is 0 (MPICH's is 0x44000000), so `communicator == 0` alone cannot mean none was supplied. A caller whose struct_size predates this field is read as before: `communicator != 0` means supplied, 0 means none. A caller that sets has_communicator=1 may pass communicator == 0; fuse_setup() then treats it as supplied (communicator_set becomes true and my_component's Mpmd/Connect handling runs on it)")
FUSE_ABI_STRUCT_END(fuse_setup_options)

FUSE_ABI_STRUCT(fuse_field_name, "a field named in the graph")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(const char*,    c_ptr,      component,    "NUL-terminated component name")
FUSE_ABI_FIELD(const char*,    c_ptr,      field,        "NUL-terminated field name")
FUSE_ABI_STRUCT_END(fuse_field_name)

FUSE_ABI_STRUCT(fuse_field_ref, "what the graph knows about a named field, resolved once at setup")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  handle,       "pass to register_field; stable for the context's lifetime")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  components,   "values per entity the graph declares")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  intent,       "0 export (Provides), 1 import (Requires), 2 both")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  conservation, "0 none, 1 intensive, 2 extensive")
FUSE_ABI_STRUCT_END(fuse_field_ref)

FUSE_ABI_STRUCT(fuse_field_view, "caller-owned storage bound to a field; the pointer must stay valid until destroy")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  handle,       "from field_handle")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  element_type, "FUSE_ELEMENT_*")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  memspace,     "FUSE_MEMSPACE_*")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  ownership,    "FUSE_OWNERSHIP_*")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  components,   "values per entity; must equal fuse_field_ref.components")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  count,        "entities on this process (owned first when ghosted)")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  owned_count,  "owned entities; equals count unless ghosted")
FUSE_ABI_FIELD(int64_t,        c_int64_t,  stride,       "elements between consecutive entities (1 = packed)")
FUSE_ABI_FIELD(int64_t,        c_int64_t,  component_stride, "elements between consecutive components of one entity (count*stride = structure-of-arrays, 1 = array-of-structures)")
FUSE_ABI_FIELD(void*,          c_ptr,      data,         "the storage")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  window_samples, "as an INPUT to register_field, ignored: an application always registers its own native, single-sample storage, never the window path's K-wide buffer. As the OUTPUT of view_field: 0 for an ordinary field (data/count describe the field's own registered storage), or K (the window's sample capacity, fuse::window_sample_capacity(), fuse/model/coupling_graph.hpp) for a field that is part of a coupling window, export or import. When K > 0, `data` points at the window path's own private buffer: for an export, the member's OpKind::WindowAdvance output; for an import, the window Sink's arc (a read-only view of what the window path delivered), or for a LowFive-bound channel (FieldSpec::hdf5_path set on the channel's source) the OpKind::ExternalDelivery arc that feeds that Sink, which nothing else in the compiled plan touches. Layout: `count` is unchanged (entities), `components` is widened to the declared width times K, array-of-structures (component_stride=1, stride=components), so element e's K samples are contiguous at data[e*components .. e*components+components-1], sample 0 the window-start value and the rest the per-substep end values advance_window() writes (a window member's field has components==1, E-RT-WINDOW-LAYOUT, so in practice components==K). A caller that wants K reads window_samples directly. Ignored by a caller whose struct_size predates this field, per abi-design.md rule 2; see FirstFrozenStructSize<fuse_field_view> (src/abi/participant.cpp)")
FUSE_ABI_STRUCT_END(fuse_field_view)

FUSE_ABI_STRUCT(fuse_step_request, "which component is stepping (participant direction); the appended members (provider direction) carry the window and flags a provider's advance() must honor, so fuse_step_request and fuse_step_report carry the same exact-time shape in both directions (docs/dev/abi-design.md, \"Provider direction\"). begin_step/end_step do not read the appended members")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(const char*,    c_ptr,      component,    "NUL-terminated component name; must be one this process hosts")
FUSE_ABI_FIELD(fuse_exact_time, fuse_exact_time, t_begin, "provider direction: start of the window advance() must cover; unused by begin_step/end_step")
FUSE_ABI_FIELD(fuse_exact_time, fuse_exact_time, t_end,   "provider direction: end of the window advance() must cover; unused by begin_step/end_step")
FUSE_ABI_FIELD(int64_t,        c_int64_t,  step,         "provider direction: step index within the run; unused by begin_step/end_step")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  iteration,    "provider direction: sweep index inside an implicit coupling group, 0 outside; unused by begin_step/end_step")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  requires_checkpoint, "provider direction: 1 if the provider must save its state before advancing; unused by begin_step/end_step")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  requires_restore,    "provider direction: 1 if the provider must restore the state it saved and advance again; unused by begin_step/end_step")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  reserved,     "0; fills the padding so a later appended member changes sizeof (abi-design.md rule 3)")
FUSE_ABI_STRUCT_END(fuse_step_request)

FUSE_ABI_STRUCT(fuse_step_report, "what the coupler decided about this step; exact time, never a double")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  requires_checkpoint, "1 if the component must save its state before advancing (begin_step)")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  requires_restore,    "1 if the component must restore the state it saved and advance again (end_step)")
FUSE_ABI_FIELD(int64_t,        c_int64_t,  step,         "step index within the run")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  iteration,    "sweep index inside an implicit coupling group; 0 outside")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  reserved,     "0")
FUSE_ABI_FIELD(fuse_exact_time, fuse_exact_time, t_begin, "start of the step")
FUSE_ABI_FIELD(fuse_exact_time, fuse_exact_time, t_end,   "end of the step")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  next_component, "participant direction: fuse_end_step() sets this to the graph-declared component index the compiled instruction stream expects at this process's next begin_step, or -1 if that call closed the period. fuse_begin_step() cannot resolve it (this component's advance() has not run yet) and reports -2, undetermined; call fuse_end_step() first. Unused by the provider's advance(). Gives several externally driven window members that share a window of more than one substep a direct answer instead of a guessed call order (E-ABI-STEP-ORDER otherwise)")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  reserved2,    "0; fills the padding after next_component so that step_opened, below, changes sizeof (abi-design.md rule 3)")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  step_opened,  "participant direction: 1 if this call's matching fuse_begin_step() opened a step on the component it was asked for; 0 if resuming the instruction stream instead ran a time-window member's coupling iteration through to convergence and on to this period's end, a legitimate outcome and not an error. On 0 the Runner completed this period's bookkeeping, started the next one, and primed its first request without opening a step on the component fuse_begin_step() was called with, because that component's next turn may belong to a different period or component; next_component names the one whose request is now pending, no step is open on any component, and fuse_end_step() on the component this call was asked for is refused (E-ABI-STEP-NOT-OPEN). The caller's loop must call fuse_begin_step(next_component) itself before doing anything else. A participant sharing a time window across more than one externally driven member must read this report, because a member on one side of such a window cannot know from outside whether the coupling iteration it does not itself participate in has converged. Always 1 on the ordinary path (no time window, or no LowFive-bound channel feeding one), and always 1 from fuse_end_step(), which only echoes an already-open step. Reads as 1 for a caller whose struct_size predates this field, per abi-design.md rule 2")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  reserved3,    "0; fills the padding after step_opened so that period, below, changes sizeof (abi-design.md rule 3)")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  period,       "the same counter fuse_ongoing::period reports (both read the context's periods_completed), set on every fuse_step_report regardless of step_opened. A caller comparing this value with what it last saw sees it advance exactly when periods_completed does, whether or not step_opened is 0 on the same call; this makes a matched rollover (step_opened=1, but the opening request came from a new period started mid-call) visible")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  reserved4,    "0; period takes sizeof(fuse_step_report) from 80 to 84, rounded up to 88 (the struct holds int64 members), leaving four bytes of trailing padding; this member fills them so that delivery_pending, below, changes sizeof (abi-design.md rule 3) instead of landing in that padding. test/abi/struct_sizes.golden records 72 before step_opened, 88 after period")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  delivery_pending, "1 on the report of the fuse_begin_step() call that returned because Runner::Impl suspended the instruction stream at a LowFive-bound channel's OpKind::ExternalDelivery proxy; this distinguishes that reason for step_opened==0 from the other one (an ordinary period rollover with no delivery pending). 0 otherwise, including every step_opened==1 call and every fuse_end_step() call. Each ExternalDelivery proxy is its own report, so a graph that suspends both the exporter and the importer of one channel, or has several independently paced LowFive-bound channels, never loses a proxy's field identity; delivery_field, below, names which field the report is about. Protocol: on a report with delivery_pending==1 naming field F (delivery_field), H5Dwrite F if you produce it or H5Dread F if you consume it (via view_field()), then call fuse_begin_step(next_component), never elsewhere. Reads as 0 for a caller whose struct_size predates this field, per abi-design.md rule 2; see FirstFrozenStructSize<fuse_step_report> (src/abi/participant.cpp)")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  reserved5,    "0; delivery_pending takes sizeof from 88 to 92, rounded up to 96, leaving four bytes of trailing padding; this member fills them so that delivery_field, below, changes sizeof (abi-design.md rule 3). struct_sizes.golden records 104 after delivery_field")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  delivery_field, "valid only when delivery_pending==1: the delivering channel's source field, as the same FieldId-derived handle fuse_field_ref::handle uses (fuse_field_handle()). One channel, one field, named explicitly: a caller never has to guess which of several independently paced LowFive-bound channels a delivery_pending==1 report is about (ExternalAdvanceRequest::delivery_field, fuse/runtime/runner.hpp, has the Runner-side account). -1 when delivery_pending==0, written explicitly by the ABI on every report; never a valid field handle (fuse_field_handle() never returns a negative handle). Not written for a caller whose struct_size predates this field, per abi-design.md rule 2")
FUSE_ABI_STRUCT_END(fuse_step_report)

FUSE_ABI_STRUCT(fuse_ongoing, "whether and where the coupling stands")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  ongoing,      "1 while there is a step left to take")
FUSE_ABI_FIELD(int64_t,        c_int64_t,  period,       "coupling period index")
FUSE_ABI_FIELD(fuse_exact_time, fuse_exact_time, now,     "the current coupling time")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  next_component, "the graph-declared component index the compiled instruction stream expects at this process's next begin_step. fuse_is_coupling_ongoing() stays side-effect-free; a period's start needs no resumption, because the compiled stream is static once schedule() has built it and the first externally driven component of a period is a fixed property of the plan (Runner::components_due_at_period_start()). Resolved from a prior fuse_begin_step()/fuse_end_step() this period if one cached it, or (nothing cached means a period is about to start) read directly from the plan. -1 for a graph with no externally driven component (fuse_run() drives those). See fuse_step_report.next_component for the mid-period case, where -2 remains that field's answer")
FUSE_ABI_STRUCT_END(fuse_ongoing)

FUSE_ABI_STRUCT(fuse_run_request, "for an in-process driver: let the coupler run the loop")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(int64_t,        c_int64_t,  periods,      "how many coupling periods; -1 = until the end time")
FUSE_ABI_STRUCT_END(fuse_run_request)

FUSE_ABI_STRUCT(fuse_base_communicator_info, "the base communicator this context's setup() formed, if any: the one thing Connect-mode (accept/connect) launch otherwise never hands back to a caller; read-only, a local (non-collective) read of state setup()'s collective already agreed identically on every rank")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(int64_t,        c_int64_t,  communicator, "Fortran handle (MPI_Comm_c2f) of this context's base communicator -- the same value setup() stored internally and RunnerConfig::base_communicator/MpiTransport::set_communicator use, for every launch mode (InProcess, Plugin, Mpmd, Connect, LowFive); 0 if setup() was never given a nonzero communicator")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  formed,       "1 if setup() was given a communicator (communicator_set) -- a nonzero handle, or handle 0 together with has_communicator=1 (Open MPI's Fortran handle for MPI_COMM_WORLD is 0) -- 0 otherwise. A caller must check this before trusting `communicator`")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  reserved,     "0; fills the padding so that an appended member changes sizeof (abi-design.md rule 3): struct_size(4)+pad(4)+communicator(8)+formed(4) leaves 4 bytes of trailing padding before this field")
FUSE_ABI_STRUCT_END(fuse_base_communicator_info)

/* ---- the table, in order; appended to, never reordered ----------------- */
FUSE_ABI_ENTRY(version,             fuse_null,          fuse_version_info,  "ctx may be NULL")
FUSE_ABI_ENTRY(capabilities,        fuse_null,          fuse_capability_set,  "ctx may be NULL")
FUSE_ABI_ENTRY(create,              fuse_null,          fuse_context_out,   "ctx must be NULL")
FUSE_ABI_ENTRY(destroy,             fuse_null,          fuse_null,          "a double destroy is FUSE_ERR_INVALID, not a crash")
FUSE_ABI_ENTRY(last_error,          fuse_null,          fuse_error,         "ctx NULL asks the thread-local error of a failed create")
FUSE_ABI_ENTRY(load_graph,          fuse_graph_source,  fuse_null,          "once per context, before setup")
FUSE_ABI_ENTRY(save_graph,          fuse_null,          fuse_graph_sink,    "the canonical bytes of the loaded graph")
FUSE_ABI_ENTRY(setup,               fuse_setup_options,         fuse_null,          "communicator and end time; before initialize; COLLECTIVE over the communicator")
FUSE_ABI_ENTRY(field_handle,        fuse_field_name,    fuse_field_ref,     "after load_graph")
FUSE_ABI_ENTRY(register_field,      fuse_field_view,    fuse_null,          "before initialize; once per handle")
FUSE_ABI_ENTRY(initialize,          fuse_null,          fuse_null,          "compiles and schedules; COLLECTIVE")
FUSE_ABI_ENTRY(is_coupling_ongoing, fuse_null,          fuse_ongoing,       "")
FUSE_ABI_ENTRY(begin_step,          fuse_step_request,  fuse_step_report,   "the component's imports are current on return; COLLECTIVE over the component's processes")
FUSE_ABI_ENTRY(end_step,            fuse_step_request,  fuse_step_report,   "the component's exports are read on entry; COLLECTIVE over the component's processes")
FUSE_ABI_ENTRY(run,                 fuse_run_request,   fuse_null,          "FUSE_ERR_UNSUPPORTED (E-ABI-RUN-EXTERNAL) only when an externally driven component is hosted on this process; legal on a process hosting none (a coupler-only placement, or any rank with no externally driven component of its own), which still executes its share of the period's collectives")
FUSE_ABI_ENTRY(view_field,          fuse_field_ref,     fuse_field_view,    "the reverse of register_field: FUSE hands back a view of its own storage for the named handle. Named view_field, not field_view, because the latter collides with the fuse_field_view type it returns once Fortran lower-cases both. Before initialize, this is the native storage register_field was given. After initialize, a window-scoped field (see fuse_field_view.window_samples) returns the window path's own private buffer instead -- the surface through which an application on a LowFive-bound window channel reads the waveform it must write, or writes the waveform it must deliver. FUSE_ERR_NOTFOUND if the handle names no field in the loaded graph")

FUSE_ABI_ENTRY(base_communicator,   fuse_null,          fuse_base_communicator_info, "a local, non-collective read of this context's communicator and communicator_set, already agreed identically on every rank by setup()'s collective (connect.hpp); lets a Connect-mode (accept/connect) caller recover the merged base communicator setup() formed internally. Legal before setup() (formed=0, communicator=0) and for every launch mode: InProcess/Plugin/Mpmd callers get back their own, already trivial, base communicator the same way")
FUSE_ABI_ENTRY(request_restart_point, fuse_null, fuse_null, "an externally driven (ABI) participant's way to ask that a restart point be taken: sets a flag (fuse::Runner::request_restart_point()) and never writes a file itself, because write_restart_point() needs a RestartWriter the embedding host process configures (a file path, an HDF5 layout), which this entry's fixed (ctx, in, out) shape cannot carry. The embedding host polls fuse::Runner::take_restart_point_request() after every run_period()/resume_period() call and decides whether, and how, to act. Idempotent: several calls before the host polls leave exactly one pending request. Legal any time after initialize(); has no effect before it, since no Runner exists yet to hold the flag")

/* ---- provider direction: the coupler calls a plugin --------------------
 * The struct catalogue above is SHARED: fuse_null, fuse_version_info,
 * fuse_capability_set, fuse_field_view and fuse_step_request/fuse_step_report
 * (grown above with the window fields this direction needs) are reused
 * exactly as written for the participant direction, so a window or a field
 * view is the same bytes on either side of the coupler. Only the structs
 * this direction alone needs are new, below.
 *
 * A provider's own per-instance opaque handle takes the ctx slot of THE ONE
 * RULE's shape, typed `fuse_provider_ctx*` rather than `fuse_ctx*` so the
 * two directions' handles cannot be passed to each other's tables by
 * accident -- both are forward-declared opaque structs, so the distinction
 * is enforced by the type system, not just by convention. */

FUSE_ABI_STRUCT(fuse_field_spec, "one field a provider provides, requires, or both -- one row of what describe() reports")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(const char*,    c_ptr,      name,         "NUL-terminated, valid for the call only")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  components,   "values per entity this provider declares")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  intent,       "0 export (Provides), 1 import (Requires), 2 both -- same convention as fuse_field_ref.intent")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  element_type, "FUSE_ELEMENT_*")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  memspace,     "FUSE_MEMSPACE_*; defaults to FUSE_MEMSPACE_HOST for a struct_size set before this member existed (abi-design.md rule 2). FUSE_MEMSPACE_DEVICE is refused at registration unless this provider's capabilities() also reports FUSE_CAP_DEVICE_FIELDS; the two together, not this field alone, is what the library trusts")
FUSE_ABI_FIELD(int32_t,        c_int32_t,  reserved,     "zero; abi-design.md rule 3: memspace alone (28 -> 32 bytes) would land in the struct's existing trailing padding and change nothing a struct_size check could see, so it is paired with this member to push sizeof from 32 to 40")
FUSE_ABI_STRUCT_END(fuse_field_spec)

FUSE_ABI_STRUCT(fuse_field_table, "caller-owned buffer of fuse_field_spec rows; the query-size pattern fuse_graph_sink already uses")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(fuse_field_spec*, c_ptr,    buffer,       "in: caller's array, or NULL to query the count only")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  capacity,     "in: rows available in buffer")
FUSE_ABI_FIELD(uint64_t,       c_int64_t,  written,      "out: rows this provider has; nothing is written when it exceeds capacity")
FUSE_ABI_STRUCT_END(fuse_field_table)

FUSE_ABI_STRUCT(fuse_provider_instance, "a new provider instance")
FUSE_ABI_FIELD(uint32_t,       c_int32_t,  struct_size,  "")
FUSE_ABI_FIELD(fuse_provider_ctx*, c_ptr,  self,         "owned by the caller until destroy")
FUSE_ABI_STRUCT_END(fuse_provider_instance)

/* ---- the provider table, in order; appended to, never reordered -------- */
FUSE_ABI_PROVIDER_ENTRY(version,    fuse_null,          fuse_version_info,   "self may be NULL; the plugin's own library version")
FUSE_ABI_PROVIDER_ENTRY(create,     fuse_null,          fuse_provider_instance, "self must be NULL")
FUSE_ABI_PROVIDER_ENTRY(destroy,    fuse_null,          fuse_null,          "a double destroy is FUSE_ERR_INVALID, not a crash")
FUSE_ABI_PROVIDER_ENTRY(describe,   fuse_null,          fuse_field_table,   "after create, before bind; the fields this instance provides and/or requires")
FUSE_ABI_PROVIDER_ENTRY(bind,       fuse_field_view,    fuse_null,          "before the first advance; once per field describe() reported; the pointer must stay valid until destroy")
FUSE_ABI_PROVIDER_ENTRY(advance,    fuse_step_request,  fuse_step_report,   "integrate from in->t_begin to in->t_end; out echoes the window actually run, exactly (rule 6)")
FUSE_ABI_PROVIDER_ENTRY(save_state, fuse_null,          fuse_null,          "checkpoint the state advance() mutates, so the same interval can be re-advanced; only one checkpoint need be retained")
FUSE_ABI_PROVIDER_ENTRY(restore_state, fuse_null,       fuse_null,          "restore the state captured by the most recent successful save_state()")
FUSE_ABI_PROVIDER_ENTRY(capabilities, fuse_null,        fuse_capability_set, "self may be NULL; FUSE_CAP_CHECKPOINT means save_state/restore_state are real, not the default no-op")
FUSE_ABI_PROVIDER_ENTRY(save_restart_blob, fuse_null, fuse_restart_blob_sink, "an opaque, versioned byte record capturing whatever save_state()'s in-memory rollback cannot reach (component-private state outside register_fields()' own storage). Same-decomposition restore only: the rank-count refusal that gates this happens above this ABI boundary, in fuse::check_restart_rank_count(). FUSE_CAP_CHECKPOINT has no bearing on this entry; a provider not implementing it reports written=0 and blob_version=0, which the caller treats as nothing to capture, not as an error, exactly as the C++ Component::save_restart_blob() default does")
FUSE_ABI_PROVIDER_ENTRY(load_restart_blob, fuse_restart_blob_source, fuse_null, "the read-back counterpart of save_restart_blob(); FUSE_ERR_VERSION (not a silent misread) if blob_version names a version this build does not recognise, the same posture kGraphVersion takes for the coupling graph (fuse/model/descriptor.hpp)")

#ifdef FUSE_ABI_STRUCT_DEFINED_HERE
#undef FUSE_ABI_STRUCT
#undef FUSE_ABI_STRUCT_DEFINED_HERE
#endif
#ifdef FUSE_ABI_FIELD_DEFINED_HERE
#undef FUSE_ABI_FIELD
#undef FUSE_ABI_FIELD_DEFINED_HERE
#endif
#ifdef FUSE_ABI_STRUCT_END_DEFINED_HERE
#undef FUSE_ABI_STRUCT_END
#undef FUSE_ABI_STRUCT_END_DEFINED_HERE
#endif
#ifdef FUSE_ABI_ENTRY_DEFINED_HERE
#undef FUSE_ABI_ENTRY
#undef FUSE_ABI_ENTRY_DEFINED_HERE
#endif
#ifdef FUSE_ABI_PROVIDER_ENTRY_DEFINED_HERE
#undef FUSE_ABI_PROVIDER_ENTRY
#undef FUSE_ABI_PROVIDER_ENTRY_DEFINED_HERE
#endif
#ifdef FUSE_ABI_ENUM_DEFINED_HERE
#undef FUSE_ABI_ENUM
#undef FUSE_ABI_ENUM_DEFINED_HERE
#endif
